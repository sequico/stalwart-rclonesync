[Unit]
Description=Two-way sync: Stalwart group Files <-> pCloud (every 15 minutes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Adjust the remotes / flags below for your setup. Credentials live in the
# rclone config of the user running this unit (~/.config/rclone/rclone.conf).
ExecStart=/usr/local/bin/stalwart-rclonesync \
    --left-remote  pcloud:StalwartSync \
    --right-remote freight-dav: \
    --right-untrusted-mtime \
    --ignore-prefix 1 \
    --state-dir /var/lib/stalwart-rclonesync \
    --log /var/log/stalwart-rclonesync.log
Nice=10
IOSchedulingClass=idle
